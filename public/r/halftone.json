{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "halftone",
  "title": "Halftone",
  "description": "Dot-pattern mask reveal — text emerges from a halftone print texture.",
  "files": [
    {
      "path": "registry/default/halftone/halftone.tsx",
      "content": "import { type ElementType, type CSSProperties } from 'react';\nimport { cn } from '@/lib/utils';\n\nexport interface HalftoneProps {\n  children: React.ReactNode;\n  /** Delay before the reveal begins, in ms. */\n  delay?: number;\n  /** Reveal duration, in ms. */\n  duration?: number;\n  /** Dot size in pixels. */\n  dotSize?: number;\n  /** Element tag. */\n  as?: ElementType;\n  className?: string;\n}\n\nexport function Halftone({\n  children,\n  delay = 0,\n  duration = 1400,\n  dotSize = 6,\n  as: Component = 'span',\n  className\n}: HalftoneProps) {\n  return (\n    <Component\n      className={cn('inline-block animate-trickle-halftone', className)}\n      style={{\n        animationDelay: `${delay}ms`,\n        animationDuration: `${duration}ms`,\n        ['--trickle-halftone-size' as string]: `${dotSize}px`\n      } as CSSProperties}\n    >\n      {children}\n    </Component>\n  );\n}\n",
      "type": "registry:ui",
      "target": "components/trickle/halftone.tsx"
    }
  ],
  "cssVars": {
    "theme": {
      "--animate-trickle-halftone": "trickle-halftone 1.4s cubic-bezier(0.4, 0, 0.2, 1) both"
    }
  },
  "css": {
    "@keyframes trickle-halftone": {
      "/* Dots appear small, then PULSE at increasing amplitudes (like a heart-beat\n     building up), then quickly grow huge to merge into the solid letters. */\n  0%": {
        "-webkit-mask-size": "var(--trickle-halftone-size, 6px) var(--trickle-halftone-size, 6px)",
        "mask-size": "var(--trickle-halftone-size, 6px) var(--trickle-halftone-size, 6px)",
        "opacity": "0",
        "filter": "contrast(1.4)"
      },
      "10%": {
        "opacity": "1",
        "filter": "contrast(1.3)"
      },
      "18%": {
        "-webkit-mask-size": "calc(var(--trickle-halftone-size, 6px) * 1.6) calc(var(--trickle-halftone-size, 6px) * 1.6)",
        "mask-size": "calc(var(--trickle-halftone-size, 6px) * 1.6) calc(var(--trickle-halftone-size, 6px) * 1.6)"
      },
      "28%": {
        "-webkit-mask-size": "var(--trickle-halftone-size, 6px) var(--trickle-halftone-size, 6px)",
        "mask-size": "var(--trickle-halftone-size, 6px) var(--trickle-halftone-size, 6px)"
      },
      "40%": {
        "-webkit-mask-size": "calc(var(--trickle-halftone-size, 6px) * 2.2) calc(var(--trickle-halftone-size, 6px) * 2.2)",
        "mask-size": "calc(var(--trickle-halftone-size, 6px) * 2.2) calc(var(--trickle-halftone-size, 6px) * 2.2)",
        "filter": "contrast(1.15)"
      },
      "52%": {
        "-webkit-mask-size": "calc(var(--trickle-halftone-size, 6px) * 1.4) calc(var(--trickle-halftone-size, 6px) * 1.4)",
        "mask-size": "calc(var(--trickle-halftone-size, 6px) * 1.4) calc(var(--trickle-halftone-size, 6px) * 1.4)"
      },
      "68%": {
        "-webkit-mask-size": "80px 80px",
        "mask-size": "80px 80px",
        "filter": "contrast(1.05)"
      },
      "100%": {
        "-webkit-mask-size": "800% 800%",
        "mask-size": "800% 800%",
        "filter": "contrast(1)",
        "opacity": "1"
      }
    },
    "@media (prefers-reduced-motion: reduce)": {
      ".animate-trickle-halftone": {
        "animation": "none",
        "-webkit-mask-image": "none",
        "mask-image": "none",
        "filter": "none",
        "opacity": "1"
      }
    }
  },
  "type": "registry:ui"
}