{
  "name": "trickle",
  "version": "0.1.0",
  "private": true,
  "description": "Pure-CSS text animations for React. Zero runtime, SSR-safe, shadcn-style copy-paste registry.",
  "license": "MIT",
  "homepage": "https://tricklekit.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/akaieuan/trickle-UI-kit"
  },
  "scripts": {
    "dev": "next dev",
    "build": "pnpm registry:build && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "registry:build": "shadcn build",
    "registry:validate": "tsx scripts/validate-registry.ts",
    "new": "tsx scripts/new-component.ts",
    "changeset": "changeset",
    "version": "changeset version"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@next/eslint-plugin-next": "^16.4.5",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.14.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=20 <26"
  },
  "packageManager": "pnpm@10.4.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
